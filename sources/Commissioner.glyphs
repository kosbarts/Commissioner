sub guillemetleft by guillemetleft.case;
sub guillemetright by guillemetright.case;
sub guilsinglleft by guilsinglleft.case;
sub guilsinglright by guilsinglright.case;
sub at by at.case;
sub brevecomb-cy by brevecomb-cy.case;
sub tonos by tonos.case;
sub dieresiscomb by dieresiscomb.case;
sub dotaccentcomb by dotaccentcomb.case;
sub gravecomb by gravecomb.case;
sub acutecomb by acutecomb.case;
sub hungarumlautcomb by hungarumlautcomb.case;
sub circumflexcomb by circumflexcomb.case;
sub circumflexcomb_gravecomb by circumflexcomb_gravecomb.case;
sub circumflexcomb_acutecomb by circumflexcomb_acutecomb.case;
sub circumflexcomb_tildecomb by circumflexcomb_tildecomb.case;
sub circumflexcomb_hookabovecomb by circumflexcomb_hookabovecomb.case;
sub caroncomb by caroncomb.case;
sub brevecomb by brevecomb.case;
sub brevecomb_gravecomb by brevecomb_gravecomb.case;
sub brevecomb_acutecomb by brevecomb_acutecomb.case;
sub brevecomb_tildecomb by brevecomb_tildecomb.case;
sub brevecomb_hookabovecomb by brevecomb_hookabovecomb.case;
sub tildecomb by tildecomb.case;
sub macroncomb by macroncomb.case;
sub hookabovecomb by hookabovecomb.case;
sub dblgravecomb by dblgravecomb.case;
sub breveinvertedcomb by breveinvertedcomb.case;
";
tag = case;
},
{
automatic = 1;
code = "lookupflag IgnoreMarks;
sub f f i by f_f_i;
sub f f l by f_f_l;
sub f f by f_f;
sub f i by fi;
sub f l by fl;
";
tag = liga;
},
{
code = "lookup fclash {
	sub [f f_f]' [b h hbrevebelow hcircumflex hdotbelow k kcommaaccent l lacute lcaron lcommaaccent ldot ldotbelow lj llinebelow thorn] by [f.calt f_f.calt];
	} fclash;

lookup uppercaseSharpS {
	sub @Uppercase germandbls' @Uppercase by germandbls.calt;
	sub @Uppercase @Uppercase germandbls' by germandbls.calt;
	sub germandbls' @Uppercase by germandbls.calt;
	} uppercaseSharpS;

lookup yiukr {
	sub yi-cy' yi-cy by yi-cy.calt1;
	sub yi-cy.calt1 yi-cy' by yi-cy.calt2;
	} yiukr; 

lookup grek_anoteleia2 {
	ignore sub @grekAll periodcentered' @grekAll;
	sub @grekAll periodcentered' by anoteleia;
} grek_anoteleia2;

lookup grek_tonosCap {
	ignore sub @grekCapsTonos' @nonLetter @grekCaps @grekLc; #Prevents the supression of the tonos in an uppercase if it is followed by an Uppercase followed by a lowercase (Ώ Άριστη)
	ignore sub @nonLetter Etatonos' @nonLetter @nonLetter; #makes sure the Etatonos will remain even if it is followed by a comma and a space in the middle of a sentence or paragraph. 
	sub @nonLetter @grekCapsTonos' @nonLetter @nonLetter by @grekCapsTonosless; #suppresses the tonos for all Uppercase with Tonos if they are followed by at least two nonletters (so the tonos will remain in the case of ‘Ο,τι but will drop for Ώ!) in the middle of a sentence or paragraph. 
	sub @grekCapsTonos' @grekCaps by @grekCapsTonosless; #suppresses all tonos within a word
	sub @grekCaps @grekCapsTonos' by @grekCapsTonosless; #suppresses all tonos within a word
	ignore sub Etatonos' @nonLetter @grekCaps; #makes sure the Etatonos will remain even if it is in the beginning of a paragraph. 
	sub @grekCapsTonos' @nonLetter @grekCaps by @grekCapsTonosless; #suppresses the tonos for all isolated Uppercase with Tonos if they are in the beginning of a paragraph. 
	ignore sub Etatonos' @nonLetter @nonLetter; #makes sure the Etatonos will remain even if it is followed by a comma and a space in the beginning of a paragraph. 
	sub @grekCapsTonos' @nonLetter @nonLetter by @grekCapsTonosless; #suppresses the tonos for all Uppercase with Tonos if they are followed by at least two nonletters (so the tonos will remain in the case of ‘Ο,τι but will drop for Ώ!) in the beginning of a paragraph. 
	} grek_tonosCap;

lookup grek_dieresisCapInsertion {
	sub [Alphatonos Epsilontonos Omicrontonos Upsilontonos Alpha.calt Epsilon.calt Omicron.calt Upsilon.calt] Iota' by Iotadieresis.calt;
	sub [Alphatonos Epsilontonos Etatonos Omicrontonos Omegatonos Alpha.calt Epsilon.calt Eta.calt Omicron.calt Omega.calt] Upsilon' by Upsilondieresis.calt;
} grek_dieresisCapInsertion;

lookup grek_dieresistonosCapInsertion1 {
	sub Iotadieresis' [acutecomb acutecomb.case]' by Iotadieresis.calt;
	sub Upsilondieresis' [acutecomb acutecomb.case]' by Upsilondieresis.calt; 
} grek_dieresistonosCapInsertion1;

lookup grek_dieresistonosCapInsertion2 {
	sub Iota' [dieresiscomb dieresiscomb.case]' [acutecomb acutecomb.case]' by Iotadieresis.calt;
	sub Upsilon' [dieresiscomb dieresiscomb.case]' [acutecomb acutecomb.case]' by Upsilondieresis.calt;
} grek_dieresistonosCapInsertion2;

";
tag = calt;
},
{
automatic = 1;
