# Postprocessing  with BuildSTAT
build $
    /var/folders/c1/ktl0ssn12_dgzfv4p6zflbqr0000gn/T/tmp87mtlzue.buildStatstamp: $
    buildSTAT-postprocess $
    ../fonts/variable/Commissioner[FLAR,VOLM,wght].ttf $
    ../fonts/variable/Commissioner-Italic[FLAR,VOLM,wght].ttf | $
    ../fonts/variable/Commissioner[FLAR,VOLM,wght].ttf $
    ../fonts/variable/Commissioner-Italic[FLAR,VOLM,wght].ttf
  stamp =  && touch $
      /var/folders/c1/ktl0ssn12_dgzfv4p6zflbqr0000gn/T/tmp87mtlzue.buildStatstamp
  postprocess = buildStat
  args = --src /var/folders/c1/ktl0ssn12_dgzfv4p6zflbqr0000gn/T/tmphyhhmjo_
# Generating ../fonts/webfonts/Commissioner-Thin.woff2
build ../fonts/webfonts/Commissioner-Thin.woff2: compress $
    ../fonts/ttf/Commissioner-Thin.ttf
  operation = compress
# Generating ../fonts/webfonts/Commissioner-ExtraLight.woff2
build ../fonts/webfonts/Commissioner-ExtraLight.woff2: compress $
